{
  "name": "youtube-firefox-extension",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "build:firefox": "node esbuild.config.mjs firefox",
    "build:chromium": "node esbuild.config.mjs chromium",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "update:firefox": "node scripts/firefox-update.mjs"
  },
  "devDependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "adm-zip": "^0.6.1",
