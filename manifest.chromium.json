{
  "manifest_version": 3,
  "name": "YouTube MP4 Downloader",
  "version": "0.1.13",
  "description": "Download available MP4 streams without re-encoding.",
  "permissions": [
    "downloads",
    "scripting",
    "storage",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.googlevideo.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "site-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube MP4 Downloader"
  },
  "minimum_chrome_version": "116"
}
